# API Configuration
# VITE_API_URL se detecta automaticamente segun el hostname (opcional)
VITE_API_URL=http://localhost:3000

# Analytics (PostHog)
VITE_PUBLIC_POSTHOG_KEY=phc_your_posthog_key_here
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Feature Flags
VITE_SHOW_WHATSAPP_FIELD=true

# Store (upload imagen + toggle mostrar en tienda)
VITE_STORE_ENABLED=false

# Cobranzas: mostrar la opcion en el menu (false = solo se entra por la URL /cobranzas)
VITE_SHOW_COBRANZAS_MENU=false
